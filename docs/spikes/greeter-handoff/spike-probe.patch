+/// SPIKE (plan 44 premise, never committed): CRTC state and per-connector probe timing.
+fn spike_dump<D: smithay::reexports::drm::control::Device>(dev: &D, at: &str, force: bool) {
+    let Ok(res) = dev.resource_handles() else { return };
+    for &c in res.crtcs() {
+        if let Ok(i) = dev.get_crtc(c) {
+            info!(elapsed_ms = crate::startup::elapsed_ms(), at, ?c, mode = ?i.mode().map(|m| m.size()), fb = ?i.framebuffer(), "spike: crtc");
+        }
+    }
+    for &c in res.connectors() {
+        let t = std::time::Instant::now();
+        if let Ok(i) = dev.get_connector(c, force) {
+            info!(elapsed_ms = crate::startup::elapsed_ms(), at, force, conn = %format!("{:?}-{}", i.interface(), i.interface_id()), state = ?i.state(), enc = ?i.current_encoder(), took_us = t.elapsed().as_micros() as u64, "spike: connector");
+        }
+    }
+}
