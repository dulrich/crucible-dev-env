+/// SPIKE (plan 44 WP-1, never committed): closes the scanout framebuffers' handles with
+/// DRM_IOCTL_MODE_CLOSEFB so the kernel does not disable the CRTC when this fd closes.
+#[allow(unsafe_code)]
+fn spike_retain(state: &CrucibleState<UdevData>) {
+    use smithay::reexports::drm::control::Device as _;
+    use std::os::fd::{AsFd, AsRawFd};
+    #[repr(C)]
+    struct CloseFb {
+        fb_id: u32,
+        pad: u32,
+    }
+    const DRM_IOCTL_MODE_CLOSEFB: libc::c_ulong = 0xC008_64D0;
+    let mut log = std::fs::OpenOptions::new().create(true).append(true).open("/tmp/cde-greeter-spike.log").ok();
+    let mut note = |s: String| {
+        info!("{s}");
+        if let Some(f) = log.as_mut() {
+            use std::io::Write as _;
+            let _ = writeln!(f, "{} ms {s}", crate::startup::elapsed_ms());
+        }
+    };
+    // Variant C: blank the VT text so the console fbdev restores on exit shows black, not logs.
+    if device::spike_flag("GREETER_CLEAR_VT") {
+        let vt = std::env::var("XDG_VTNR").ok().map(|n| format!("/dev/tty{n}"));
+        for p in std::iter::once("/dev/tty".to_string()).chain(vt) {
+            match std::fs::OpenOptions::new().write(true).open(&p) {
+                Ok(mut f) => {
+                    use std::io::Write as _;
+                    let r = f.write_all(b"\x1b[0m\x1b[40m\x1b[H\x1b[2J\x1b[3J\x1b[?25l");
+                    note(format!("spike: clear-vt {p} -> {r:?}"));
+                    break;
+                }
+                Err(e) => note(format!("spike: clear-vt {p} open failed: {e}")),
+            }
+        }
+    }
+    for backend in state.backend_data.backends.values() {
+        let dev = backend.drm_output_manager.device();
+        device::spike_dump(dev, "greeter exit", false);
+        let Ok(res) = dev.resource_handles() else { continue };
+        for &c in res.crtcs() {
+            let Some(fb) = dev.get_crtc(c).ok().and_then(|i| i.framebuffer()) else { continue };
+            let mut arg = CloseFb { fb_id: fb.into(), pad: 0 };
+            let rc = unsafe { libc::ioctl(dev.as_fd().as_raw_fd(), DRM_IOCTL_MODE_CLOSEFB, &mut arg) };
+            let errno = std::io::Error::last_os_error();
+            note(format!("spike: closefb {c:?} {fb:?} rc={rc} errno={errno}"));
+        }
+    }
 }
